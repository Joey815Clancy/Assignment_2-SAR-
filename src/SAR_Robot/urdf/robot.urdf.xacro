<?xml version="1.0"?>
<robot name="walle">
<!--BASE LINK-->
  <link name="base_link">
    <visual>
      <geometry><box size="1.4 1.0 0.3"/></geometry>
      <origin xyz="0 0 0.65" rpy="0 0 0"/>
      <material name="red"><color rgba="1.0 0.0 0.0 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="1.4 1.0 0.3"/></geometry>
      <origin xyz="0 0 0.65" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0.65" rpy="0 0 0"/>
      <inertia ixx="0.454" ixy="0.0" ixz="0.0"
               iyy="0.854" iyz="0.0"
               izz="1.233"/>
    </inertial>
  </link>
<!-- LEFT WHEEL -->
  <link name="left_wheel">
    <visual>
      <geometry><cylinder radius="0.5" length="0.1"/></geometry>
      <material name="blue"><color rgba="0.0 0.0 1.0 1.0"/></material>
    </visual>
    <collision><geometry><cylinder radius="0.5" length="0.1"/></geometry></collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0317" ixy="0.0" ixz="0.0"
               iyy="0.0317" iyz="0.0"
               izz="0.0625"/>
    </inertial>
  </link>
<!-- LEFT WHEEL JOINT -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.6 0.5" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
<!-- RIGHT WHEEL -->
  <link name="right_wheel">
    <visual>
      <geometry><cylinder radius="0.5" length="0.1"/></geometry>
      <material name="blue"><color rgba="0.0 0.0 1.0 1.0"/></material>
    </visual>
    <collision><geometry><cylinder radius="0.5" length="0.1"/></geometry></collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0317" ixy="0.0" ixz="0.0"
               iyy="0.0317" iyz="0.0"
               izz="0.0625"/>
    </inertial>
  </link>
<!-- RIGHT WHEEL JOINT -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.6 0.5" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
<!-- CASTER WHEEL -->
  <link name="caster_wheel">
    <visual>
      <geometry><sphere radius="0.25"/></geometry>
      <material name="grey"><color rgba="0.4 0.4 0.4 1.0"/></material>
    </visual>
    <collision><geometry><sphere radius="0.25"/></geometry></collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0025" ixy="0.0" ixz="0.0"
               iyy="0.0025" iyz="0.0"
               izz="0.0025"/>
    </inertial>
  </link>
<!-- CASTER WHEEL JOINT -->
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="0.55 0 0.25" rpy="0 0 0"/>
  </joint>
<!-- CAMERA -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.05 0.15 0.08"/></geometry>
      <material name="black"><color rgba="0.05 0.05 0.05 1.0"/></material>
    </visual>
    <collision><geometry><box size="0.05 0.15 0.08"/></geometry></collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>
  </link>
<!-- CAMERA JOINT -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.725 0 0.65" rpy="0 0 0"/>
  </joint>
<!-- LIDAR -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.08" length="0.07"/></geometry>
      <material name="dark_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
    </visual>
    <collision><geometry><cylinder radius="0.08" length="0.07"/></geometry></collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>
  </link>
<!-- LIDAR JOINT -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.835" rpy="0 0 0"/>
  </joint>

  <!-- DIFFERENTIAL DRIVE PLUGIN -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>1.2</wheel_separation>
      <wheel_radius>0.5</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
  </gazebo>

  <!-- Camera sensor -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <topic>camera/image</topic>
      <update_rate>30</update_rate>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- 2D Lidar sensor -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.2</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Wheel friction -->
  <gazebo reference="left_wheel">
    <mu1>1.0</mu1><mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="right_wheel">
    <mu1>1.0</mu1><mu2>1.0</mu2>
  </gazebo>

  <!-- Caster friction -->
  <gazebo reference="caster_wheel">
    <mu1>0.0</mu1><mu2>0.0</mu2>
  </gazebo>
</robot>
